# Local (non-Docker) settings. Copy to backend/.env.

APP_NAME="File Intelligence Platform"
APP_VERSION=1.0.1
DEBUG=false

# Relative SQLite paths resolve against backend/.
DATABASE_URL=sqlite+aiosqlite:///./data/fip.db
DATABASE_ECHO=false

# The server binds to loopback by default. Keep it that way unless you have
# deliberately isolated the host: the scanner reads any path it can access.
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=json

SCAN_DEFAULT_THREADS=4
SCAN_BATCH_SIZE=100

# AI is optional. Choose one provider and set its key.
AI_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
BAZAARLINK_API_KEY=
BAZAARLINK_MODEL=

WATCH_ENABLED=false
