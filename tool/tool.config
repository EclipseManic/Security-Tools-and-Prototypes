# LogTriage configuration (INI format)
#
# Values here override built-in defaults. Command-line flags override this file.
# Relative paths are resolved from the directory you run the tool in.
# Unknown sections, unknown keys, and invalid values are rejected with exit 2.

[detection]
# Seconds between events that still belong to the same cluster.
window_seconds = 20
# Failed SSH logins required inside the window (5 in 20s is rare for a human).
brute_threshold = 5
# HTTP 4xx/5xx responses required inside the window.
scan_threshold = 10
# Distinct blocked destination ports required inside the window.
port_scan_threshold = 8
# Seconds after an SSH burst to look for a successful login.
success_window_seconds = 300

[limits]
# Year used for syslog lines that have no year. Omit to use the current year.
# assume_year = 2026
# Maximum input size in bytes (default: 50 MiB).
max_bytes = 52428800

[output]
out_dir = sample_output
output_prefix = triage
# both, json, or md.
format = both

[run]
# Default input log. Leave commented out to require --input each run.
# input = sample_input/triage_sample.log
# JSON watchlist. Omit to auto-detect tool/watchlist.json next to the script.
# watchlist = tool/watchlist.json
no_watchlist = false
# Exit 1 when overall risk reaches this level: low, medium, high, or critical.
# fail_on = high
quiet = false
no_color = false
