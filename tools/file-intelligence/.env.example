# Docker Compose settings. Copy to .env before `docker compose up`.
# For running without Docker, use backend/.env.example instead.

# Optional AI provider: gemini, openrouter, openai, bazaarlink, none
AI_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
BAZAARLINK_API_KEY=
BAZAARLINK_MODEL=

# Host directory mounted read-only at /host-files in the container.
# Defaults to the synthetic examples/sample-data folder.
HOST_SCAN_PATH=./examples/sample-data
